# ===== LOCAL DEVELOPMENT values (used by `npm run dev`) =====
# On Vercel, set the same names in: Project -> Settings -> Environment Variables
# (Vercel values override this file during the build.)
# Only names that start with VITE_ are visible to the code. They end up in the browser, so NEVER put secrets here.

# REQUIRED - backend API root, including the /api part, no trailing slash
VITE_API_BASE_URL=http://localhost:8080/api

# OPTIONAL - backend root used for images (/files/...). Default = VITE_API_BASE_URL without "/api"
VITE_FILES_BASE_URL=http://localhost:8080

# OPTIONAL - chat WebSocket (SockJS) URL. Default = <VITE_FILES_BASE_URL>/ws/chat
VITE_WS_URL=http://localhost:8080/ws/chat

# OPTIONAL - Home page (a section is hidden while its value is empty)
VITE_DESKTOP_APP_URL=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_SUPPORT_EMAIL=
