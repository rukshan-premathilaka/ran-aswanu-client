# Copy these names into Vercel -> Project -> Settings -> Environment Variables (Production + Preview).
# Use your REAL backend server address. It must be https:// (a https Vercel site cannot call http:// or ws:// backends).

VITE_API_BASE_URL=https://api.your-backend-domain.com/api
VITE_FILES_BASE_URL=https://api.your-backend-domain.com
VITE_WS_URL=https://api.your-backend-domain.com/ws/chat

# Optional
VITE_DESKTOP_APP_URL=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_SUPPORT_EMAIL=
